# Purchase Intelligence App — environment variables
#
# Milestone 1 / Slice 0 requires NO environment variables to run.
# These placeholders document configuration introduced in later slices.
# Copy this file to .env.local (gitignored) and fill in values when needed.

# --- Database (Slice 1: Supabase Postgres via Drizzle) ---
# DATABASE_URL=

# --- Supabase (Slice 1+) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Storage bucket for receipt images (Slice 4) ---
# SUPABASE_RECEIPTS_BUCKET=receipts
